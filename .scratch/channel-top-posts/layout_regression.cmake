cmake_minimum_required(VERSION 3.20)
project(TopPostsLayoutRegression LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
set(TBUILD_ROOT "E:/TBuild" CACHE PATH "Existing native Windows dependency root")
set(TEST_QT_VERSION "5.15.19" CACHE STRING "Installed Qt version")
set(CMAKE_PREFIX_PATH "${TBUILD_ROOT}/Libraries/win64/Qt-${TEST_QT_VERSION}")
find_package(Qt5 REQUIRED COMPONENTS Widgets)
add_executable(layout_regression layout_regression.cpp)
target_link_libraries(layout_regression PRIVATE Qt5::Widgets Qt5::QWindowsIntegrationPlugin)
get_property(qt_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(qt_target IN LISTS qt_targets)
    get_target_property(qt_links ${qt_target} INTERFACE_LINK_LIBRARIES)
    if(qt_links)
        list(FILTER qt_links EXCLUDE REGEX "libEGL|libGLESv2")
        set_property(TARGET ${qt_target} PROPERTY INTERFACE_LINK_LIBRARIES "${qt_links}")
    endif()
    foreach(prop IMPORTED_LINK_INTERFACE_LIBRARIES_DEBUG IMPORTED_LINK_DEPENDENT_LIBRARIES_DEBUG IMPORTED_LINK_INTERFACE_LIBRARIES_RELEASE IMPORTED_LINK_DEPENDENT_LIBRARIES_RELEASE)
        get_target_property(qt_deps ${qt_target} ${prop})
        if(qt_deps)
            list(FILTER qt_deps EXCLUDE REGEX "libEGL|libGLESv2")
            set_property(TARGET ${qt_target} PROPERTY ${prop} "${qt_deps}")
        endif()
    endforeach()
    get_target_property(qt_options ${qt_target} INTERFACE_LINK_OPTIONS)
    if(qt_options)
        string(REGEX REPLACE "[^ ;<>]*libEGL\\.lib" "" qt_options "${qt_options}")
        string(REGEX REPLACE "[^ ;<>]*libGLESv2\\.lib" "" qt_options "${qt_options}")
        set_property(TARGET ${qt_target} PROPERTY INTERFACE_LINK_OPTIONS "${qt_options}")
    endif()
endforeach()
target_link_libraries(layout_regression PRIVATE
    "${TBUILD_ROOT}/Libraries/win64/tg_angle/out/Debug/tg_angle.lib"
    "${TBUILD_ROOT}/Libraries/win64/zlib/Debug/libzsd.lib"
    d3d9 d3d11 dxgi dxguid)
